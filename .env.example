AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/v1/
AZURE_DEPLOYMENT=your-deployment-name

# ACA session pool management endpoint (local dev uses http://localhost:8080)
POOL_MANAGEMENT_ENDPOINT=http://localhost:8080

# Frontend URL for CORS in production (e.g. https://your-app.azurecontainerapps.io)
FRONTEND_URL=

# Document processing (required)
# ADLS Gen2: stores originals + converted markdown. Needs Storage Blob Data Contributor role.
ADLS_ACCOUNT_NAME=
ADLS_FILESYSTEM=documents
# Content Understanding: converts uploads to markdown via prebuilt-layout.
# Uses the same Foundry resource as AZURE_ENDPOINT — no separate endpoint needed.

# Knowledge base (required)
# Azure AI Search service with agentic retrieval enabled.
# Run `uv run python setup_knowledge_base.py` after setting these to create the KB.
# Run `uv run python index_knowledge_base.py` to upload sample data PDFs to ADLS.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KB_NAME=rfp-knowledge
# ADLS connection for setup_knowledge_base.py (the indexer needs access to ADLS):
#
# Method A — Managed identity (recommended). Provide subscription/resource group
# and the setup script builds a ResourceId connection string automatically:
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
#
# Method B — Direct connection string. Set this to skip Method A:
# ADLS_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# IP restriction (optional — locks both container apps to a single IP)
# ALLOWED_IP=1.2.3.4/32

# Entra ID / Easy Auth (optional — production only)
# Create the app registration manually, then set these to enable Easy Auth
# on the orchestrator and bake MSAL config into the frontend.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=   # defaults to https://<frontend-url> if omitted

# Session container settings
# CHAT_TIMEOUT_SECONDS=300   # Max seconds to wait for an agent turn (default: 300)
# LOG_AGENT_EVENTS=true      # Print structured agent loop events to terminal (local dev only)

